    {
      "id": 7492,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F93B7.png\u0026#39;)\"\u003e\u003cb\u003e📷\u003c/b\u003e\u003c/i\u003e احسان امینی معروف به «حاج احسان» از نیروهای سرکوبگر پلیس در کلانتری شهرک غرب و از بسیجیان فعال در جنوب تهران است که در سرکوب اعتراضات سال ۹۸، ۱۴۰۱ و دی‌ماه ۱۴۰۴ نقش فعال داشت.\u003cbr/\u003e\u003cbr/\u003eادرس منزل او در منطقه ۱۸ تهران، محله یافت‌آباد، میدان معلم، خیابان یادگار، خیابان قناعت...[ادامه آدرس موجود است].\u003cbr/\u003e\u003cbr/\u003eاو دارنده یک دستگاه موتور سی جی ۱۲۵ بدون پلاک، یک دستگاه خودرو کوئیک سفید به شماره پلاک ۴۶ط۵۹۹ ایران/۶۰ است.\u003cbr/\u003e\u003cbr/\u003eنامبرده عادت دارد برای خودنمایی و ایجاد رعب و وحشت همراه همکاران با موتورهای سنگین و پرسروصدا و همگی بدون پلاک به سمت محل زندگی خود ویراژ ‌دهد و در موارد متعدد به بهانه‌های مختلف اقدام به درگیری با اهل محل کرده است.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%A7%D8%AD%D8%B3%D8%A7%D9%86_%D8%A7%D9%85%DB%8C%D9%86%DB%8C\"\u003e#احسان_امینی\u003c/a\u003e \u003ca href=\"?q=%23%D8%B4%D9%86%D8%A7%D8%B3%D8%A7%DB%8C%DB%8C\"\u003e#شناسایی\u003c/a\u003e \u003ca href=\"?q=%23%D8%AF%DB%8C%DB%B1%DB%B4%DB%B0%DB%B4\"\u003e#دی۱۴۰۴\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
