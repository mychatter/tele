    {
      "id": 9411,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5841473431744287874\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9B91.png\u0026#39;)\"\u003e\u003cb\u003e🛑\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e \u003cb\u003eتلاش جمهوری اسلامی برای تسلیح دوباره حزب‌الله؛ آماده‌سازی برای دور تازه رویارویی با اسرائیل\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eکانال ۱۴ اسرائیل در گزارشی اعلام کرد که جمهوری اسلامی با وجود سقوط حکومت بشار اسد و مختل شدن مسیرهای سنتی قاچاق تسلیحات از سوریه،تلاش‌های خود را برای بازسازی توان نظامی حزب‌الله لبنان افزایش داده است.\u003cbr/\u003eبر اساس این گزارش،تهران در تلاش است با انتقال تسلیحات و مواد منفجره به لبنان،حزب‌الله را برای دور تازه‌ای از درگیری احتمالی با اسرائیل آماده کند.\u003cbr/\u003eدر تازه‌ترین موارد،نیروهای امنیتی سوریه یک کامیون حامل تسلیحات را در نزدیکی دمشق که به مقصد لبنان حرکت می‌کرد،توقیف کردند. هم‌زمان،ارتش لبنان نیز از کشف ۲۶۴ کیلوگرم مواد منفجره قاچاق‌شده از سوریه خبر داد.\u003cbr/\u003eکانال ۱۴ به نقل از داده‌های مرکز پژوهشی «آلما» گزارش داد که از ۱۷ آوریل تا ۲۳ نوامبر ۲۰۲۶،دست‌کم ۱۴ مورد رهگیری محموله‌های تسلیحاتی به مقصد لبنان ثبت شده است که بیشتر آن‌ها برای حزب‌الله در نظر گرفته شده بودند. از این تعداد،هفت محموله به دست ارتش لبنان و شش محموله توسط نیروهای امنیتی سوریه توقیف شده و یک محموله نیز هدف حمله ارتش اسرائیل قرار گرفته است.\u003cbr/\u003eاین گزارش همچنین هشدار می‌دهد که بازسازی توان نظامی حزب‌الله تنها با هدف مقابله با اسرائیل صورت نمی‌گیرد،بلکه می‌تواند برای فشار بر مخالفان داخلی این گروه تروریستی در لبنان نیز مورد استفاده قرار گیرد.\u003cbr/\u003eبه نوشته کانال ۱۴،لبنان اکنون در شرایطی شکننده قرار دارد؛ از یک‌سو فشار نظامی اسرائیل ادامه دارد و از سوی دیگر،حزب‌الله با حمایت جمهوری اسلامی در تلاش برای احیای توان تسلیحاتی و گسترش نفوذ خود است؛ وضعیتی که می‌تواند زمینه‌ساز دور تازه‌ای از بی‌ثباتی و درگیری در منطقه شود.\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%86%DB%8C%D8%A7%D8%A8%D8%AA%DB%8C\"\u003e#نیابتی\u003c/a\u003e \u003ca href=\"?q=%23%D8%AC%D9%85%D9%87%D9%88%D8%B1%DB%8C_%D8%A7%D8%B3%D9%84%D8%A7%D9%85%DB%8C\"\u003e#جمهوری_اسلامی\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
